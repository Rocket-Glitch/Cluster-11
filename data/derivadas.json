  "tarjetas": [
    {
      "Pregunta": "\\( 1. \\, \\frac{d}{dx}[n] = \\)",
      "Respuesta": "\\( 0 \\)"
    },
    {
      "Pregunta": "\\( 2. \\, \\frac{d}{dx}[n \\cdot u] = \\)",
      "Respuesta": "\\( n \\cdot u' \\)"
    },
    {
      "Pregunta": "\\( 3. \\, \\frac{d}{dx}[x^n] = \\)",
      "Respuesta": "\\( n \\cdot x^{n-1} \\)"
    },
    {
      "Pregunta": "\\( 4. \\, \\frac{d}{dx}[u \\cdot v] = \\)",
      "Respuesta": "\\( u' \\cdot v + v' \\cdot u \\)"
    },
    {
      "Pregunta": "\\( 5. \\, \\frac{d}{dx}\\left[\\frac{u}{v}\\right] = \\)",
      "Respuesta": "\\( \\frac{u' \\cdot v - v' \\cdot u}{v^2} \\)"
    },
    {
      "Pregunta": "\\( 6. \\, \\frac{d}{dx}\\left[\\sqrt[n]{u}\\right] = \\)",
      "Respuesta": "\\( \\frac{u'}{n \\cdot \\sqrt[n]{u^{n-1}}} \\)"
    },
    {
      "Pregunta": "\\( 7. \\, \\ln(e) = \\)",
      "Respuesta": "\\( 1 \\)"
    }
  ]
